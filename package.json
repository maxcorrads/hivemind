{
  "name": "hivemind",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local hive for Human, brains, and workers",
  "bin": {
    "hivemind": "./bin/hivemind.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n hive,ui -c yellow,cyan \"tsx watch src/cli.ts serve\" \"vite\"",
    "start": "tsx src/cli.ts serve",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "mcp": "tsx src/mcp/index.ts",
    "hivemind": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=75",
    "typecheck:server": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run typecheck:browser",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "lint": "oxlint --deny-warnings src web scripts tests vite.config.ts playwright.config.ts",
    "test:inbox-bounds": "tsx --test src/server/inbox-bounds.test.ts",
    "benchmark:inbox": "tsx scripts/benchmark-inbox.ts",
    "benchmark:coordination": "node scripts/benchmark-coordination.mjs --all",
    "test:browser": "playwright test",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "browser:server": "npm run build && vite preview --config tests/browser/preview.config.ts",
    "test:unit": "node scripts/run-tests.mjs --suite=unit",
    "test:integration": "node scripts/run-tests.mjs --suite=integration",
    "check:all": "node scripts/check-all.mjs",
    "replay:timeline": "node --import tsx scripts/replay-timeline.mjs",
    "benchmark:timeline": "node --import tsx scripts/benchmark-timeline.mjs",
    "benchmark:timeline:diagnosis": "node --import tsx scripts/benchmark-timeline-diagnosis.mjs",
    "benchmark:coordination:pilot": "node scripts/benchmark-coordination-real.mjs prepare --preset pilot-v1",
    "benchmark:coordination:clarification": "node scripts/benchmark-coordination-real.mjs prepare --preset clarification-v1",
    "benchmark:coordination:pilot:run": "node scripts/run-coordination-pilot-codex.mjs",
    "benchmark:coordination:run": "node scripts/run-coordination-pilot-codex.mjs",
    "benchmark:coordination:mcp-errors": "node scripts/analyze-coordination-mcp-errors.mjs",
    "benchmark:human-decisions": "node scripts/benchmark-human-decisions.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "hono": "^4.13.8",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.5",
    "oxlint": "1.85.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "files": [
    "bin",
    "dist/node",
    "dist/web",
    "README.md",
    "BOT-PROTOCOL.md",
    "PLUGINS.md",
    "EXTENSIBILITY-SECURITY.md",
    "COORDINATION.md",
    "NOTIFICATIONS.md",
    "ROOMS.md",
    "TASK-PROTOCOL.md",
    "DELIVERY-PROTOCOL.md",
    "CONTRIBUTING.md",
    "TESTING.md",
    "docs"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
